# Copy to .env and fill in real values. Never commit .env.

# MongoDB (Atlas or local replica set — replica set required for Prisma nested writes)
# Atlas:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/drip-client-reseller?retryWrites=true&w=majority"
# Local:
# DATABASE_URL="mongodb://127.0.0.1:27017/drip-client-reseller?replicaSet=rs0"
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/drip-client-reseller?retryWrites=true&w=majority"

# Signed customer session cookie secret (min 32 random chars)
# Admin panel: login as a User with role=ADMIN (no separate admin password)
CUSTOMER_SESSION_SECRET="replace-with-long-random-string-at-least-32-chars"

# Public app origin (redirects, absolute links, Secure cookie when https://)
# Local: http://localhost:3102
# Production (this VPS): https://dripclientofficial.dev — also set in ecosystem.config.cjs
NEXT_PUBLIC_APP_URL="http://localhost:3102"

# Payment: manual (instant fulfill) | stripe (Phase 4.9+)
PAYMENT_MODE="manual"

# Resend (forgot-password email OTP) — or set in Admin → Settings → Authentication
RESEND_API_KEY="re_xxxxxxxx"
# Verified sender — use onboarding@resend.dev for sandbox tests
RESEND_FROM_EMAIL="Drip <onboarding@resend.dev>"

# Google OAuth (optional — hides Google button when unset)
# Or set Client ID + secret in Admin → Settings → Authentication
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenRouter — sparse AI fallback when keyword score < 3 (optional)
# https://openrouter.ai/keys — prefer free models
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# Optional Discord webhook for critical support tickets
DISCORD_WEBHOOK_URL=""

# Deposit cron — GET/POST /api/cron/deposits/poll (expire + poll Binance/QRIS/Cashfree)
# Required in production. VPS crontab:
#   * * * * * /home/kscoder/scripts/cron-deposits.sh >> /home/kscoder/scripts/cron-deposits.log 2>&1
# Drip-only helper: bash scripts/cron-deposits-poll.sh
# Manual check:
#   curl -s -H "Authorization: Bearer $CRON_SECRET" "http://127.0.0.1:3102/api/cron/deposits/poll"
CRON_SECRET=""
# DEPOSIT_PROVIDER_GRACE_MINUTES=60
# DEPOSIT_QRIS_LIVE_STATUS_LIMIT=8

# Binance Pay (USD) — transaction note/memo match
BINANCE_API_KEY=""
BINANCE_SECRET_KEY=""
BINANCE_PAY_ID=""
# Optional fallback QR if admin has not uploaded one (Settings → Deposit methods)
# BINANCE_QR_URL="/binance-pay-qr.png"
# ESEWA_QR_URL="/esewa-nepal-qr.png"

# RamaPay / RamaShop QRIS (IDR) — create + history/status check
RAMASHOP_API_KEY=""
# RAMASHOP_BASE_URL="https://ramashop.my.id/api/public"

# MGCloudPay QRIS (IDR) — backup rail, off by default (Settings → Deposit methods)
MGCLOUDPAY_API_KEY=""
# MGCLOUDPAY_BASE_URL="https://app.mgcloudpay.my.id"

# Cashfree PG (INR) — UPI + cards hosted checkout + webhook + cron recheck
# API version: 2025-01-01. Dashboard webhook: {NEXT_PUBLIC_APP_URL}/api/webhooks/cashfree
# Production keys must use CASHFREE_ENV=production + NEXT_PUBLIC_CASHFREE_MODE=production.
# Production also requires https NEXT_PUBLIC_APP_URL (Cashfree rejects http return/notify).
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# Dashboard Developers → Webhooks → secret (preferred for signature verify)
CASHFREE_WEBHOOK_SECRET=""
CASHFREE_ENV="sandbox"
NEXT_PUBLIC_CASHFREE_MODE="sandbox"

# Capacitor Android shell — remote WebView URL (defaults to production)
# CAPACITOR_SERVER_URL="https://dripclientofficial.dev"
# CAPACITOR_DEBUG="true"
