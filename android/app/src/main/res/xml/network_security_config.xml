<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production shell loads HTTPS only (Capacitor cleartext=false). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
